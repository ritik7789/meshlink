<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_attach_panel"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="New chat"
        android:textColor="#E9EDEF"
        android:textSize="20sp" />

    <!-- Search is always present rather than revealed behind an icon: with a
         mesh of many nodes, filtering is the primary way to find one. -->
    <EditText
        android:id="@+id/etNodeSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Search nodes"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#E9EDEF"
        android:textColorHint="#8696A0"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxHeight="420dp"
        android:minHeight="120dp" />

    <TextView
        android:id="@+id/tvNoNodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp"
        android:text="No nodes match that name"
        android:textAlignment="center"
        android:textColor="#8696A0"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
