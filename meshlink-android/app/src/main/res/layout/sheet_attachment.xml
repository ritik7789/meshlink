<?xml version="1.0" encoding="utf-8"?>
<!--
  Attachment chooser. A bottom sheet rather than a centred dialog: it rises from
  the composer the action started at, keeps the conversation visible behind it,
  and dismisses on a swipe - a full-screen scrim for a three-item choice reads as
  far heavier than the choice deserves.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:weightSum="3">

        <LinearLayout
            android:id="@+id/optionPhoto"
            style="@style/AttachmentOption">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_circle"
                android:backgroundTint="#7F66FF"
                android:gravity="center"
                android:text="🖼"
                android:textSize="24sp" />

            <TextView
                style="@style/AttachmentLabel"
                android:text="Photo" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionSticker"
            style="@style/AttachmentOption">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_circle"
                android:backgroundTint="#F2A33C"
                android:gravity="center"
                android:text="😀"
                android:textSize="24sp" />

            <TextView
                style="@style/AttachmentLabel"
                android:text="Sticker" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionContact"
            style="@style/AttachmentOption">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_circle"
                android:backgroundTint="#00A884"
                android:gravity="center"
                android:text="👤"
                android:textSize="24sp" />

            <TextView
                style="@style/AttachmentLabel"
                android:text="Contact" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
